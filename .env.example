# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA DataMall Account Key for real-time transport, MRT, and bus infrastructure feeds
LTA_ACCOUNT_KEY=""

# OneMap API credentials for geocoding, routing, and thematic facility layers
ONEMAP_EMAIL=""
ONEMAP_PASSWORD=""
ONEMAP_ACCESS_TOKEN=""

# MAS API Key for financial & macro interest rate indicators (e.g. SORA)
MAS_API_KEY=""

